        <mxCell id="3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;arcSize=4;shadow=0;" value="" vertex="1">
          <mxGeometry x="385" y="30" width="330" height="520" as="geometry"/>
