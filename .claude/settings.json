{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --no-sync .agents/hooks/guard_uv_only.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --no-sync .agents/hooks/guard_data_readonly.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --no-sync .agents/hooks/guard_generated_files.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --no-sync .agents/hooks/route_exploration.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --no-sync .agents/hooks/check_new_file_size.py",
            "timeout": 15,
            "statusMessage": "Checking new file size..."
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --no-sync .agents/hooks/check_knowledge_index.py",
            "timeout": 15,
            "statusMessage": "Checking knowledge/ index coverage..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --no-sync .agents/hooks/format_python.py",
            "timeout": 10,
            "statusMessage": "Formatting Python file..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --no-sync .agents/hooks/session_brief.py",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --no-sync .agents/hooks/refresh_graphs.py",
            "timeout": 120,
            "statusMessage": "Refreshing project graphs..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "academic-research-skills@academic-research-skills": true,
    "caveman@caveman": true,
    "superpowers@claude-plugins-official": true,
    "last30days@last30days-skill": true,
    "mattpocock-skills@claude-plugins-official": true,
    "humanizer@humanizer": true
  }
}
